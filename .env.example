# Server
APP_BIND=0.0.0.0:8080

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/novastrum_chat

# Session/Cookie
SESSION_COOKIE_NAME=novastrum_session
SESSION_COOKIE_SECRET=change-me-in-production-with-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_MAX_DAYS=7
SESSION_IDLE_HOURS=24

# Captcha (development placeholder)
CAPTCHA_DEV_SECRET=i-am-human

# Storage
STORAGE_ROOT=storage
